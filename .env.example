# Copy to .env and fill in. Never commit .env.

# --- Application ---
ENVIRONMENT=development
DEBUG=false

# Reserved: the repositories currently use the ./data.db file directly.
DATABASE_URL=sqlite:///./data.db

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Operator-only routes: /pipelines/run-sample, /pipelines/run-fx ---
# Unset = those routes stay disabled (they fail closed with 503).
ADMIN_API_KEY=

# --- Rate limiting (requests per minute) ---
RATE_LIMIT_ENABLED=true
ANONYMOUS_RATE_LIMIT_PER_MIN=30
FREE_RATE_LIMIT_PER_MIN=30
PRO_RATE_LIMIT_PER_MIN=1000
